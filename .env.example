# Copy this file to `.env.local` for local development, and set the same
# values in Vercel → Project → Settings → Environment Variables for
# Preview + Production.

# --- Contact form email delivery (Resend) ---------------------------------
# 1. Create a free account at https://resend.com (sign up with the inbox
#    that should receive submissions so the shared test sender can reach it).
# 2. Dashboard → API Keys → create one, paste it here.
RESEND_API_KEY=

# Where contact submissions are delivered.
CONTACT_TO_EMAIL=oureditorialboard@gmail.com

# The "from" address. Leave as the Resend test sender until the domain is
# verified in Resend (Dashboard → Domains → add flourishchristianmagazine.org
# and add the DNS records). After that, switch to an address on the domain,
# e.g.  Flourish <contact@flourishchristianmagazine.org>
CONTACT_FROM_EMAIL=Flourish Contact Form <onboarding@resend.dev>

# --- Article submission ("Write for Flourish") email delivery (Resend) ----
# Uses the same RESEND_API_KEY and CONTACT_FROM_EMAIL above. Where
# submissions from the /write-for-flourish form are delivered.
#
# Resend's sending domain isn't verified yet, so the account is limited to
# sandbox mode: it can only deliver to oureditorialboard@gmail.com (the
# account's own signup address) — confirmed live, sending anywhere else
# (including writeforflourishmagazine@gmail.com) is rejected. Once
# flourishchristianmagazine.org is verified in Resend (Dashboard →
# Domains), change this to writeforflourishmagazine@gmail.com.
SUBMIT_ARTICLE_TO_EMAIL=oureditorialboard@gmail.com
